# .gdbinit for FreeBSD Kernel Debugging
# This file contains macros to inspect internals of kernel 15.

set disassembly-flavor intel

define curthread
  set $td = (struct thread *)curthread
  printf "Current Thread: %p (Name: %s)\n", $td, $td->td_name
  printf "Priority: %d, State: %d\n", $td->td_priority, $td->td_state
end
document curthread
  Displays information about the current thread (curthread).
end

define list_procs
  set $p = allproc.lh_first
  while ($p != 0)
    printf "PID: %d | Comm: %s | Proc Addr: %p\n", $p->p_pid, $p->p_comm, $p
    set $p = $p->p_list.le_next
  end
end
document list_procs
  Lists all active processes in the system (allproc).
end

define show_pcb
  set $td = (struct thread *)$arg0
  p/x *$td->td_pcb
end
document show_pcb
  Displays the Process Control Block (PCB) of a specific thread.
end

# Auto-connect Configuration
target remote :1234
echo "[+] Connected to GDB Stub on port 1234\n"
echo "[+] Use 'curthread' or 'list_procs' to start.\n"
